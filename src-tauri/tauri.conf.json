{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellWarden",
  "version": "0.0.0-dev",
  "identifier": "io.github.mohamedxiv.shellwarden",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "ShellWarden",
      "width": 1180,
      "height": 760,
      "minWidth": 760,
      "minHeight": 560,
      "center": true,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://127.0.0.1:1420 http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
